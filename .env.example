APP_NAME="Hybrid Retail BI API"
ENVIRONMENT=development
DEPLOYMENT_MODE=local_hub
API_PREFIX=/api
API_DOCS_ENABLED=true
FRONTEND_ORIGIN=http://localhost:5173
# Optional comma-separated extra origins for local dev alternates such as 127.0.0.1.
FRONTEND_EXTRA_ORIGINS=http://127.0.0.1:5173

# Local PostgreSQL system of record. DATABASE_URL remains supported for existing setups.
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/hybrid_retail_bi
LOCAL_DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/hybrid_retail_bi

# Cloud settings stay blank when no coordination gateway is configured. Supabase remains coordination-only.
CLOUD_RUNTIME_DATABASE_URL=
CLOUD_MIGRATION_DATABASE_URL=
CLOUD_GATEWAY_BASE_URL=

# Replace before exposing the app beyond local development.
SECRET_KEY=change-me-in-development
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Durable Local Hub synchronization. Leave SYNC_DEVICE_ID blank to create and persist one locally.
SYNC_DEVICE_ID=
SYNC_DEVICE_NAME="Local Business Hub"
# Server-side secret only. Never put this value in VITE_* variables or commit a real credential.
SYNC_DEVICE_SECRET=
SYNC_DEVICE_CREDENTIAL_REF=env:SYNC_DEVICE_SECRET
# Optional pre-contact scope. A successful signed heartbeat replaces these with the server-registered device scope.
SYNC_BUSINESS_GROUP_ID=
SYNC_COMPANY_ID=
SYNC_BRANCH_ID=
SYNC_SOFTWARE_VERSION=0.1.0
SYNC_BATCH_SIZE=50
SYNC_POLL_INTERVAL_SECONDS=5
SYNC_MAX_ATTEMPTS=8
SYNC_BASE_RETRY_DELAY_SECONDS=1
SYNC_MAX_RETRY_DELAY_SECONDS=300
SYNC_RETRY_JITTER_RATIO=0.2
HEARTBEAT_INTERVAL_SECONDS=30
WRITER_LEASE_SECONDS=90
CONTINUITY_STALE_AFTER_SECONDS=180

# Optional. The AI assistant must still work with deterministic tool-backed fallbacks.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
