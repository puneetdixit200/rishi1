APP_NAME="Hybrid Retail BI API"
ENVIRONMENT=development
DEPLOYMENT_MODE=local_hub
API_PREFIX=/api
API_DOCS_ENABLED=true
FRONTEND_ORIGIN=http://localhost:5173
# Optional comma-separated extra origins for local dev alternates such as 127.0.0.1.
FRONTEND_EXTRA_ORIGINS=http://127.0.0.1:5173

# Local PostgreSQL system of record. DATABASE_URL remains supported for existing setups.
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/hybrid_retail_bi
LOCAL_DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/hybrid_retail_bi

# Cloud settings stay blank in Local Hub mode. Use backend/.env.cloud.example on Vercel.
CLOUD_RUNTIME_DATABASE_URL=
CLOUD_MIGRATION_DATABASE_URL=

# Replace before exposing the app beyond local development.
SECRET_KEY=change-me-in-development
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Optional. The AI assistant must still work with deterministic tool-backed fallbacks.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
